	<queryString language="SQL">
		<![CDATA[SELECT p.Cod_Prod, p.Cod_TipoProd, p.Nome_Prod, p.Val_UnitProd, p.Val_UnitProd * 1.1 AS "Valor projeção"
FROM produto p
WHERE p.Cod_TipoProd = 1;]]>
	</queryString>
